{
  "name": "Footnote",
  "short_name": "Footnote",
  "description": "A training plan for your race. Every rule shows where it comes from.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f1e8",
  "theme_color": "#f5f1e8",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./log?shared",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "runs", "accept": [".gpx", ".tcx", "application/gpx+xml", "application/vnd.garmin.tcx+xml"] }]
    }
  }
}
